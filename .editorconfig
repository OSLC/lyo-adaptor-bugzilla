root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,xml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[adaptor-bugzilla/src/main/java/**.java]
indent_style = tab

[adaptor-bugzilla/src/test/java/**.java]
indent_size = 2
